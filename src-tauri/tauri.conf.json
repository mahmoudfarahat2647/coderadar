{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeRadar Studio",
  "version": "1.0.0",
  "identifier": "com.coderadar.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodeRadar Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CodeRadar Studio",
    "copyright": "Copyright (c) CodeRadar Studio",
    "category": "DeveloperTool",
    "shortDescription": "Code and security radar for your workspace",
    "longDescription": "CodeRadar Studio scans a local workspace against 19 Clean Architecture, security, edge case and performance rules, and renders the result on a 360 degree polar radar.",
    "createUpdaterArtifacts": false,
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libssl3"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
